{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_family": {
      "const": "pr_similarity_os.run"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "baseline": {
      "type": "object",
      "properties": {
        "schema_family": {
          "const": "pr_similarity_os.report"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "run": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "enum": [
                "running",
                "stopping",
                "interrupted",
                "completed",
                "completed_with_errors",
                "failed"
              ]
            },
            "created_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "finished_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "current_invocation_id": {
              "type": "string",
              "format": "uuid"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/error"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "revision",
            "status",
            "created_at",
            "updated_at",
            "finished_at",
            "current_invocation_id",
            "tags",
            "error"
          ],
          "additionalProperties": false
        },
        "basket": {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*/$).+$"
            },
            "partial": {
              "type": "boolean"
            },
            "total_tasks": {
              "type": "integer",
              "minimum": 0
            },
            "omitted_failed_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "sha256",
            "path",
            "partial",
            "total_tasks",
            "omitted_failed_count"
          ],
          "additionalProperties": false
        },
        "agent": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "runtime": {
              "type": "string",
              "pattern": "^opencode:v[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "resolved_runtime": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "asset_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "platform": {
                      "type": "string",
                      "minLength": 1
                    },
                    "archive_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "binary_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "receipt": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*/$).+$"
                    }
                  },
                  "required": [
                    "version",
                    "asset_name",
                    "platform",
                    "archive_sha256",
                    "binary_sha256",
                    "receipt"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "auth_mode": {
              "enum": [
                "api_key",
                "chatgpt_oauth"
              ]
            }
          },
          "required": [
            "name",
            "runtime",
            "resolved_runtime",
            "auth_mode"
          ],
          "additionalProperties": false
        },
        "config": {
          "type": "object",
          "properties": {
            "identity_version": {
              "type": "integer",
              "const": 1
            },
            "identity_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "identity_path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*/$).+$"
            }
          },
          "required": [
            "identity_version",
            "identity_sha256",
            "identity_path"
          ],
          "additionalProperties": false
        },
        "metric": {
          "type": "object",
          "properties": {
            "name": {
              "const": "mlp"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "weights_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "implementation_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "dependencies_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pythonhashseed": {
              "const": 42,
              "type": "integer"
            }
          },
          "required": [
            "name",
            "version",
            "weights_sha256",
            "implementation_sha256",
            "dependencies_sha256",
            "pythonhashseed"
          ],
          "additionalProperties": false
        },
        "last_rescore": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                "invocation_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "previous_report_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "backup_path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*/$).+$"
                },
                "receipt_path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*/$).+$"
                }
              },
              "required": [
                "at",
                "invocation_id",
                "previous_report_sha256",
                "backup_path",
                "receipt_path"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "last_reprice": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                "invocation_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "calculation_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "previous_report_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "backup_path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*/$).+$"
                },
                "receipt_path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*/$).+$"
                }
              },
              "required": [
                "at",
                "invocation_id",
                "calculation_id",
                "previous_report_sha256",
                "backup_path",
                "receipt_path"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "inference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1,
              "type": "integer"
            },
            "configured": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "$ref": "#/$defs/inference_value"
                },
                "model": {
                  "$ref": "#/$defs/inference_value"
                },
                "effort": {
                  "$ref": "#/$defs/inference_value"
                }
              },
              "required": [
                "provider",
                "model",
                "effort"
              ]
            },
            "effective": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "$ref": "#/$defs/inference_value"
                },
                "model": {
                  "$ref": "#/$defs/inference_value"
                },
                "effort": {
                  "$ref": "#/$defs/inference_value"
                },
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "attempt_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "provider": {
                        "$ref": "#/$defs/inference_value"
                      },
                      "model": {
                        "$ref": "#/$defs/inference_value"
                      },
                      "effort": {
                        "$ref": "#/$defs/inference_value"
                      }
                    },
                    "required": [
                      "attempt_id",
                      "source_ref",
                      "provider",
                      "model",
                      "effort"
                    ]
                  }
                }
              },
              "required": [
                "provider",
                "model",
                "effort",
                "attempts"
              ]
            },
            "discrepancy": {
              "type": "boolean"
            }
          },
          "required": [
            "schema_version",
            "configured",
            "effective",
            "discrepancy"
          ]
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "const": "_meta/state.json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        }
      },
      "required": [
        "schema_family",
        "schema_version",
        "run",
        "basket",
        "agent",
        "config",
        "metric",
        "last_rescore",
        "last_reprice",
        "inference"
      ],
      "additionalProperties": false,
      "title": "PR Similarity report v1",
      "allOf": [
        {
          "if": {
            "properties": {
              "run": {
                "properties": {
                  "status": {
                    "enum": [
                      "completed",
                      "completed_with_errors"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "tasks": {
                "items": {
                  "properties": {
                    "processing_status": {
                      "const": "completed"
                    }
                  }
                }
              },
              "run": {
                "properties": {
                  "finished_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "run": {
                "properties": {
                  "status": {
                    "const": "completed"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "summary": {
                "properties": {
                  "infrastructure_error_tasks": {
                    "const": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "run": {
                "properties": {
                  "status": {
                    "const": "completed_with_errors"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "summary": {
                "properties": {
                  "infrastructure_error_tasks": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "run": {
                "properties": {
                  "status": {
                    "const": "failed"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "run": {
                "properties": {
                  "error": {
                    "$ref": "#/$defs/error"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "key": {
            "type": "string",
            "pattern": "^[0-9]{3,}-[a-z0-9-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^tasks/[0-9]{3,}-[a-z0-9-]+$"
          },
          "basket_row": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "ordinal",
          "key",
          "path",
          "basket_row"
        ]
      }
    },
    "agent_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "resources"
      ],
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "size_bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size_bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_family",
    "schema_version",
    "id",
    "baseline",
    "tasks",
    "agent_input"
  ],
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "inference_value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown",
            "unsupported",
            "mixed"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "source": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ref",
            "field"
          ]
        }
      },
      "required": [
        "status",
        "value",
        "reason",
        "source"
      ]
    }
  }
}
