        "stage": {
          "enum": [
            "collect",
            "filter",
            "generate"
          ]
        },
        "kind": {
          "enum": [
            "failed",
            "rejected"
          ]
        },
        "code": {
          "type": "string"
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
