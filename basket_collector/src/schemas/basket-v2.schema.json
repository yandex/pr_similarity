        "stage",
        "kind",
        "code",
        "result_sha256"
      ]
    },
    "Discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "capped": {
          "type": "boolean"
        }
      },
      "required": [
        "matched",
        "selected",
        "capped"
      ]
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discovery": {
          "$ref": "#/$defs/Discovery"
        },
        "collect": {
          "$ref": "#/$defs/Counts"
        },
        "filter": {
          "$ref": "#/$defs/Counts"
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "generate": {
          "$ref": "#/$defs/Counts"
        }
      },
      "required": [
        "discovery",
        "collect",
        "filter",
        "selected",
        "generate"
      ]
    },
    "SelectionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selected_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^change:[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "generation_keys": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^change:[0-9a-f]{64}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "required": [
        "schema_version",
        "sha256",
        "input_sha256",
        "fingerprint",
        "selected_ids",
        "generation_keys"
      ]
    }
  },
  "additionalProperties": false,
  "description": "Canonical standalone GitHub/GitLab frozen basket, schema v2.",
  "properties": {
