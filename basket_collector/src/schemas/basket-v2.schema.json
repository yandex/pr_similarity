{
  "$defs": {
    "BasketChanges": {
      "additionalProperties": false,
      "description": "Expose changed-file metadata without the reference patch.",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/ChangedFile"
          },
          "title": "Files",
          "type": "array"
        },
        "stats": {
          "$ref": "#/$defs/ChangeStats"
        }
      },
      "required": [
        "files",
        "stats"
      ],
      "title": "BasketChanges",
      "type": "object"
    },
    "BasketMeta": {
      "additionalProperties": false,
      "description": "Frozen v2 basket with complete stage coverage and explicit omissions.",
      "properties": {
        "schema_family": {
          "const": "pr_similarity_os.basket",
          "default": "pr_similarity_os.basket",
          "title": "Schema Family",
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "stage": {
          "const": "export",
          "default": "export",
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "interrupted",
            "failed",
            "completed"
          ],
          "title": "Status",
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "settings": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Settings",
          "type": "object"
        },
        "settings_hash": {
          "title": "Settings Hash",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "lineage": {
          "items": {
            "$ref": "#/$defs/LineageReceipt"
          },
          "title": "Lineage",
          "type": "array"
        },
        "repository": {
          "$ref": "#/$defs/Repository"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completed At"
        },
        "counts": {
          "$ref": "#/$defs/Counts"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageError"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "maintainers": {
          "items": {
            "type": "string"
          },
          "title": "Maintainers",
          "type": "array"
        },
        "partial": {
          "title": "Partial",
          "type": "boolean"
        },
        "omissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Omission"
          }
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "selection": {
          "$ref": "#/$defs/SelectionReceipt"
        }
      },
      "required": [
        "status",
        "input",
        "settings",
        "settings_hash",
        "producer",
        "lineage",
        "repository",
        "started_at",
        "updated_at",
        "completed_at",
        "counts",
        "error",
        "name",
        "description",
        "maintainers",
        "partial",
        "schema_version",
        "omissions",
        "coverage",
        "selection"
      ],
      "title": "BasketMeta",
      "type": "object"
    },
    "BasketRecord": {
      "additionalProperties": false,
      "description": "Frozen source, revisions, changes and executable task text.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^change:[0-9a-f]{64}$"
        },
        "revisions": {
          "$ref": "#/$defs/BasketRevisions"
        },
        "changes": {
          "$ref": "#/$defs/BasketChanges"
        },
        "task": {
          "$ref": "#/$defs/TaskContent"
        },
        "agent_task": {
          "title": "Agent Task",
          "type": "string"
        },
        "workspace": {
          "title": "Workspace",
          "type": "string"
        },
        "golden_diff": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Golden Diff"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "change_request": {
          "$ref": "#/$defs/BasketChangeRequest"
        },
        "source": {
          "$ref": "#/$defs/SourceDescriptor"
        },
        "diff_policy": {
          "type": "string",
          "const": "git_source_changes_v1"
        }
      },
      "required": [
        "id",
        "revisions",
        "changes",
        "task",
        "agent_task",
        "workspace",
        "provenance",
        "change_request",
        "source",
        "diff_policy"
      ],
      "title": "BasketRecord",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "change_request": {
                "properties": {
                  "kind": {
                    "const": "merge_request"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "source_revisions": {
                    "properties": {
                      "diff_version_id": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]*$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "BasketRevisions": {
      "additionalProperties": false,
      "description": "Expose the frozen before and after Git revisions.",
      "properties": {
        "policy": {
          "type": "string",
          "const": "change_merge_base_v1"
        },
        "before": {
          "title": "Before",
          "type": "string"
        },
        "after": {
          "title": "After",
          "type": "string"
        },
        "before_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "after_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "policy",
        "before",
        "after",
        "before_tree",
        "after_tree"
      ],
      "title": "BasketRevisions",
      "type": "object"
    },
    "ChangeStats": {
      "additionalProperties": false,
      "description": "Summarize changed files, lines, and patch characters.",
      "properties": {
        "files_count": {
          "minimum": 0,
          "title": "Files Count",
          "type": "integer"
        },
        "additions": {
          "minimum": 0,
          "title": "Additions",
          "type": "integer"
        },
        "deletions": {
          "minimum": 0,
          "title": "Deletions",
          "type": "integer"
        },
        "changed_lines": {
          "minimum": 0,
          "title": "Changed Lines",
          "type": "integer"
        },
        "patch_chars": {
          "minimum": 0,
          "title": "Patch Chars",
          "type": "integer"
        }
      },
      "required": [
        "files_count",
        "additions",
        "deletions",
        "changed_lines",
        "patch_chars"
      ],
      "title": "ChangeStats",
      "type": "object"
    },
    "ChangedFile": {
      "additionalProperties": false,
      "description": "Describe one changed regular file and its Git blob sides.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "status": {
          "enum": [
            "added",
            "modified",
            "deleted"
          ],
          "title": "Status",
          "type": "string"
        },
        "additions": {
          "minimum": 0,
          "title": "Additions",
          "type": "integer"
        },
        "deletions": {
          "minimum": 0,
          "title": "Deletions",
          "type": "integer"
        },
        "before_blob": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before Blob"
        },
        "after_blob": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "After Blob"
        },
        "before_mode": {
          "anyOf": [
            {
              "enum": [
                "100644",
                "100755"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before Mode"
        },
        "after_mode": {
          "anyOf": [
            {
              "enum": [
                "100644",
                "100755"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "After Mode"
        }
      },
      "required": [
        "path",
        "status",
        "additions",
        "deletions",
        "before_blob",
        "after_blob",
        "before_mode",
        "after_mode"
      ],
      "title": "ChangedFile",
      "type": "object"
    },
    "Counts": {
      "additionalProperties": false,
      "description": "Track the mutually exclusive outcomes of stage input records.",
      "properties": {
        "input": {
          "minimum": 0,
          "title": "Input",
          "type": "integer"
        },
        "succeeded": {
          "minimum": 0,
          "title": "Succeeded",
          "type": "integer"
        },
        "rejected": {
          "minimum": 0,
          "title": "Rejected",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "pending": {
          "minimum": 0,
          "title": "Pending",
          "type": "integer"
        }
      },
      "required": [
        "input",
        "succeeded",
        "rejected",
        "failed",
        "pending"
      ],
      "title": "Counts",
      "type": "object"
    },
    "Generation": {
      "additionalProperties": false,
      "description": "Record task provenance, attempts, and optional API details.",
      "properties": {
        "issue_ids": {
          "items": {
            "type": "string"
          },
          "title": "Issue Ids",
          "type": "array"
        },
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "response_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Id"
        },
        "response_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Model"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Request Sha256"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reused_from": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "issue_ids",
        "attempts",
        "response_id",
        "response_model",
        "usage",
        "request_sha256",
        "input_sha256"
      ],
      "title": "Generation",
      "type": "object"
    },
    "InputReceipt": {
      "additionalProperties": false,
      "description": "Identify the immediate input stage and its content digest.",
      "properties": {
        "stage": {
          "enum": [
            "collect",
            "filter",
            "generate",
            "export"
          ],
          "title": "Stage",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "sha256"
      ],
      "title": "InputReceipt",
      "type": "object"
    },
    "IssueRef": {
      "additionalProperties": false,
      "description": "Expose a linked issue identity and URL without its body.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "url"
      ],
      "title": "IssueRef",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "LineageReceipt": {
      "additionalProperties": false,
      "description": "Record an ancestor stage and its exact settings and producer.",
      "properties": {
        "stage": {
          "enum": [
            "collect",
            "filter",
            "generate",
            "export"
          ],
          "title": "Stage",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "settings_hash": {
          "title": "Settings Hash",
          "type": "string"
        },
        "settings": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Settings",
          "type": "object"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        }
      },
      "required": [
        "stage",
        "sha256",
        "settings_hash",
        "settings",
        "producer"
      ],
      "title": "LineageReceipt",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "description": "Identify the implementation and environment that wrote a stage.",
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "implementation_sha256": {
          "title": "Implementation Sha256",
          "type": "string"
        },
        "dependencies_sha256": {
          "title": "Dependencies Sha256",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "git_version": {
          "title": "Git Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "implementation_sha256",
        "dependencies_sha256",
        "python_version",
        "git_version"
      ],
      "title": "Producer",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Expose issue references and task-generation metadata.",
      "properties": {
        "issue_refs": {
          "items": {
            "$ref": "#/$defs/IssueRef"
          },
          "title": "Issue Refs",
          "type": "array"
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        },
        "retrieval": {
          "$ref": "#/$defs/RetrievalReceipt"
        },
        "source_revisions": {
          "$ref": "#/$defs/SourceRevisions"
        }
      },
      "required": [
        "issue_refs",
        "generation",
        "retrieval",
        "source_revisions"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "github",
            "gitlab"
          ],
          "type": "string"
        },
        "server_url": {
          "type": "string",
          "pattern": "^https://[^\\s@?#]+$",
          "format": "uri"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 3
        },
        "web_url": {
          "type": "string",
          "pattern": "^https://[^\\s@?#]+$",
          "format": "uri"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "server_url",
        "project_id",
        "path",
        "web_url",
        "default_branch"
      ]
    },
    "StageError": {
      "additionalProperties": false,
      "description": "Persist a stage error and whether the operation can be retried.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "StageError",
      "type": "object"
    },
    "TaskContent": {
      "additionalProperties": false,
      "description": "Store a generated task and optional ordered subtasks.",
      "properties": {
        "task": {
          "title": "Task",
          "type": "string"
        },
        "subtasks": {
          "items": {
            "type": "string"
          },
          "title": "Subtasks",
          "type": "array"
        }
      },
      "required": [
        "task",
        "subtasks"
      ],
      "title": "TaskContent",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Record optional token counts returned by generation.",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "Usage",
      "type": "object"
    },
    "SourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vcs": {
          "type": "string",
          "const": "git"
        },
        "fetch_url": {
          "type": "string",
          "pattern": "^https://[^\\s@?#]+$",
          "format": "uri"
        },
        "fetch_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^refs/[^\\s:~^?*\\[\\\\]+$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "vcs",
        "fetch_url",
        "fetch_refs"
      ]
    },
    "RetrievalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "before": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "after": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "before_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "after_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "checked_at",
        "source_sha256",
        "before",
        "after",
        "before_tree",
        "after_tree"
      ]
    },
    "BasketChangeRequest": {
      "additionalProperties": false,
      "description": "Frozen provider-neutral change request metadata.",
      "properties": {
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "number": {
          "exclusiveMinimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Author"
        },
        "merged_at": {
          "title": "Merged At",
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "pull_request",
            "merge_request"
          ]
        }
      },
      "required": [
        "repository",
        "number",
        "url",
        "title",
        "author",
        "merged_at",
        "kind"
      ],
      "title": "BasketChangeRequest",
      "type": "object"
    },
    "SourceRevisions": {
      "additionalProperties": false,
      "description": "Preserve normalized hosting revision evidence before local Git resolution.",
      "properties": {
        "base_sha": {
          "title": "Base Sha",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "title": "Head Sha",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "merge_commit_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ],
          "title": "Merge Commit Sha"
        },
        "head_repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Head Repository"
        },
        "expected_base_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Base Sha"
        },
        "squash_commit_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ],
          "title": "Squash Commit Sha"
        },
        "commits_count": {
          "exclusiveMinimum": 0,
          "title": "Commits Count",
          "type": "integer"
        },
        "target_branch": {
          "minLength": 1,
          "title": "Target Branch",
          "type": "string"
        },
        "diff_version_id": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Diff Version Id"
        }
      },
      "required": [
        "base_sha",
        "head_sha",
        "merge_commit_sha",
        "head_repository",
        "expected_base_sha",
        "squash_commit_sha",
        "commits_count",
        "target_branch",
        "diff_version_id"
      ],
      "title": "SourceRevisions",
      "type": "object"
    },
    "Omission": {
      "type": "object",
      "additionalProperties": false,
